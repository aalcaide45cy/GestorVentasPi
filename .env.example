# Copia este fichero a .env y rellenalo. NUNCA subas .env al repositorio.
TZ=Europe/Madrid
POSTGRES_USER=gestor
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=gestorventas
DATABASE_URL=postgres://gestor:cambia-esta-contrasena@127.0.0.1:5432/gestorventas
APP_SECRET=cambia-esto-por-48-bytes-aleatorios-en-base64

# --- Copias de seguridad (F5) ---
# Carpeta de copias (por defecto ./backups). Comandos de PostgreSQL si no están en el PATH
# (en desarrollo con Docker: PG_DUMP_CMD="docker exec -i -e PGPASSWORD=... gestorventas-db pg_dump").
# BACKUP_DIR=./backups
# PG_DUMP_CMD=pg_dump
# PG_RESTORE_CMD=pg_restore

# --- Google Drive (opcional): se crean una sola vez en Google Cloud (ver GUIA-INSTALACION.md) ---
# PUBLIC_URL es la URL pública (Tailscale Funnel) y la URI de redirección autorizada en Google:
#   {PUBLIC_URL}/api/admin/drive/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://mi-equipo.tail1234.ts.net
